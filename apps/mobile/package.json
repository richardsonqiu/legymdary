{
  "name": "@legymdary/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "@legymdary/shared": "*",
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
