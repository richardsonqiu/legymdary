{
  "expo": {
    "name": "LeGYMdary",
    "slug": "legymdary",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "legymdary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.richardsonqiu.legymdary",
      "supportsTablet": false
