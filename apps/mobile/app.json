{
  "expo": {
    "name": "One Up",
    "slug": "legymdary",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "legymdary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.richardsonqiu.legymdary",
      "supportsTablet": false
    },
    "android": {
      "package": "com.richardsonqiu.legymdary",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#191919"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F0",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#191919"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
