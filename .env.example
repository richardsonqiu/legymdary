# ─────────────────────────────────────────────────────────────
# Database — libSQL (SQLite locally, Turso in production)
# ─────────────────────────────────────────────────────────────

# Local development: a SQLite file in the project root. No account needed.
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# Production (Turso — free tier): create a database at https://turso.tech
# and set these to its URL + auth token, e.g.
#   DATABASE_URL="libsql://your-db-name-you.turso.io"
#   DATABASE_AUTH_TOKEN="eyJhbGciOi..."

# ─────────────────────────────────────────────────────────────
# Auth.js (Google sign-in, one private diary per account)
# ─────────────────────────────────────────────────────────────

# Required. Generate one with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth credentials — Google Cloud Console → APIs & Services →
# Credentials → Create OAuth client ID → "Web application".
# Authorized redirect URI:  https://<your-domain>/api/auth/callback/google
#                  (local)  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email + password sign-up/sign-in works in all environments without Google,
# so you can use the app before setting the Google credentials above.

# ─────────────────────────────────────────────────────────────
# AI meal-photo analysis (Food tab)
# ─────────────────────────────────────────────────────────────

# Anthropic API key (https://console.anthropic.com). Without it, photo
# analysis is disabled but you can still log meals manually.
ANTHROPIC_API_KEY=""

# Optional tuning (defaults shown). The primary model handles every photo;
# the backup is tried once if the primary refuses, errors or returns junk.
# Set MEAL_AI_BACKUP_MODEL="" to disable the retry.
# MEAL_AI_MODEL="claude-haiku-5-5"
# MEAL_AI_BACKUP_MODEL="claude-sonnet-5-5"
# MEAL_AI_EFFORT="low"   # low | medium | high
# MEAL_AI_DAILY_LIMIT="60"  # AI photo analyses per user per day

# ─────────────────────────────────────────────────────────────
# Garmin Connect (Personal API) — each user pastes their own key in the app
# ─────────────────────────────────────────────────────────────

# Keys are encrypted at rest with a key derived from this (falls back to
# AUTH_SECRET). Set it once and never change it, or stored keys can't be read.
# GARMIN_ENCRYPTION_KEY=""

# Protects the daily sync cron (/api/cron/garmin). Vercel sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" when set in the project's env vars.
CRON_SECRET=""
